SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
SUPABASE_SECRET_KEY=replace-with-your-server-secret-key
MAX_ROOMS=8
PORT=8080
TCP_PORT=22122
MAX_TCP_CLIENTS=128

# Admin requires admin-750.sql first; empty disables management. Choose >=16 characters.
GUNNY_ADMIN_PASSWORD=change-this-admin-password

# Optional override; Render supplies RENDER_EXTERNAL_URL automatically.
GUNNY_PUBLIC_URL=https://gunny.example.com
